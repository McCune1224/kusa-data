<Layouts.app flash={@flash} nav={@nav} current_user={@current_user}>
  <div class="desk-grid animate-fade-up">
    <div class="mb-5 flex items-center justify-between border-y border-[var(--border)] py-3 text-[10px] font-semibold uppercase tracking-[0.24em] text-[var(--muted)]">
      <span><span class="mr-2 inline-block size-2 bg-[var(--accent)]"></span>Game index</span>
      <span class="hidden sm:inline">Bento · Circuit</span>
      <span class="text-orange-300">03 — Games</span>
    </div>

    <%= if @not_found do %>
      <section class="mt-10">
        <.empty_state icon="hero-question-mark-circle" title="No such game">
          <:body>
            That game slug is not in the registry. It may not be a supported start.gg
            videogame yet.
          </:body>
          <:action>
            <.btn variant="primary" navigate={~p"/"}>Back to browsing</.btn>
          </:action>
        </.empty_state>
      </section>
    <% else %>
      <section class="relative overflow-hidden rounded-[20px] border border-[var(--border)] bg-[var(--surface)]/80 backdrop-blur-sm noise">
        <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.04)_1px,transparent_1px)] bg-[size:32px_32px] opacity-40">
        </div>
        <div class="relative p-6 sm:p-7">
          <.btn variant="ghost" size="sm" icon="hero-arrow-left" navigate={~p"/"}>
            All tournaments
          </.btn>
          <p class="mt-4 text-[10px] font-semibold uppercase tracking-[0.22em] text-[var(--accent)]">
            Game page · BracketGraph shell
          </p>
          <div class="mt-2 flex flex-wrap items-baseline gap-3">
            <h1 class="text-4xl font-black uppercase tracking-[-0.05em] text-[var(--text)] sm:text-5xl">
              {@game[:name]}
            </h1>
            <span class="rounded-full border border-[var(--border)] bg-[#08070b]/60 px-3 py-1 font-mono text-xs text-[var(--muted)]">
              {@game[:slug]}
            </span>
          </div>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-[var(--muted)]">
            Upcoming {@game[:short_name]} tournaments · {format_count(@total)} · nodes: tournaments · edges: events
          </p>
          <div class="mt-5 grid gap-3 sm:grid-cols-3">
            <div class="rounded-[16px] border border-[var(--border)] bg-[#08070b]/50 px-4 py-4">
              <div class="text-[10px] font-semibold uppercase tracking-[0.18em] text-[var(--muted)]">
                Circuit
              </div>
              <div class="mt-1 font-mono text-xl font-bold tracking-tight text-[var(--text)]">
                {format_count(@total)}
              </div>
              <div class="mt-1 text-xs text-[var(--muted)]">tournaments in graph</div>
            </div>
            <div class="rounded-[16px] border border-[var(--border)] bg-[#08070b]/50 px-4 py-4">
              <div class="text-[10px] font-semibold uppercase tracking-[0.18em] text-[var(--muted)]">
                Scope
              </div>
              <div class="mt-1 text-sm font-semibold text-[var(--text)]">Upcoming</div>
              <div class="mt-1 text-xs text-[var(--muted)]">start.gg · live index</div>
            </div>
            <div class="rounded-[16px] border border-[var(--border)] bg-[#08070b]/50 px-4 py-4">
              <div class="text-[10px] font-semibold uppercase tracking-[0.18em] text-[var(--muted)]">
                Shape
              </div>
              <div class="mt-1 text-sm font-semibold text-[var(--text)]">
                DAG · events → brackets
              </div>
              <div class="mt-1 text-xs text-[var(--muted)]">Atlas.Graph style</div>
            </div>
          </div>
        </div>
      </section>

      <section class="mt-6 rounded-[20px] border border-[var(--border)] bg-[var(--surface)]/40 p-3 backdrop-blur-sm sm:p-4">
        <div class="mb-3 flex items-center justify-between px-2">
          <h2 class="text-[10px] font-semibold uppercase tracking-[0.18em] text-[var(--muted)]">
            Tournament circuit
          </h2>
          <span class="font-mono text-xs text-[var(--muted)]">{@total} total</span>
        </div>
        <div class="relative overflow-hidden rounded-[16px] border border-[var(--border)] bg-[#0a0a0f]/40">
          <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:28px_28px] opacity-30">
          </div>
          <div class="relative p-3 sm:p-4">
            <TournamentGrid.tournament_grid
              tournaments={@streams.tournaments}
              total={@total}
              loading={@loading}
              error={@error}
              empty_title="No upcoming tournaments"
              empty_body=" for this game yet"
              reset_link={~p"/"}
              reset_label="All tournaments"
              next_page={@next_page}
            />
          </div>
        </div>
      </section>
    <% end %>
  </div>
</Layouts.app>
