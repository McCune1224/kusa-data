<Layouts.app flash={@flash} nav={@nav} current_user={@current_user}>
  <div class="animate-fade-up space-y-6">
    <!-- Signal Board ticker tape -->
    <div class="-mx-4 sm:-mx-6 flex items-center gap-3 border-y-2 bg-[#ffcc00] px-4 py-2 text-xs font-black uppercase tracking-[0.14em] text-[#08070b] sm:mx-0 sm:rounded-none">
      <span class="hidden items-center gap-1.5 sm:inline-flex"><span class="size-2 animate-pulse rounded-full bg-[#08070b]"></span> LIVE</span>
      <span class="truncate">Genesis 10 — 1,842 watching — Mango vs Zain Winner's Final live now</span>
      <span class="ml-auto hidden items-center gap-2 sm:inline-flex"><span class="rounded bg-[#08070b] px-2 py-0.5 text-[10px] leading-none text-[#ffcc00]">2026</span> 40 regions</span>
    </div>

    <!-- Signal Board hero — ONE obvious search -->
    <section class="rounded-none border-2 bg-[var(--surface)] p-6 sm:p-8 lg:p-10" style="border-color:var(--border)">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between">
        <div class="min-w-0 flex-1">
          <h1 class="font-black leading-[0.85] tracking-[-0.06em] text-[44px] sm:text-[56px] lg:text-[64px]" style="color:var(--text)">
            Find your next<br /><span style="background:var(--accent); color:var(--accent-text); padding:0 8px">bracket.</span>
          </h1>
          <p class="mt-4 max-w-xl text-[15px] leading-relaxed" style="color:var(--muted)">
            One search for every tournament, city, and player. The Atlas shows where scenes live.
          </p>

          <div class="mt-6 rounded-none border-2 bg-[var(--surface2)] p-3" style="border-color:var(--border)">
            <.form for={@search_form} id="hero-search-form" phx-change="search-input" class="w-full">
              <label for="hero-search-input" class="flex items-center justify-between text-[10px] font-bold uppercase tracking-[0.18em]" style="color:var(--muted)">
                <span>Search tournaments, cities, venues, players</span>
                <span class="hidden items-center gap-1 rounded border px-1.5 py-0.5 font-mono text-[10px] sm:inline-flex" style="border-color:var(--border); color:var(--muted)">⌘K</span>
              </label>
              <div class="mt-2 flex gap-2">
                <div class="relative flex-1">
                  <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-[var(--muted)]">
                    <.icon name="hero-magnifying-glass" class="size-5" />
                  </span>
                  <.input
                    id="hero-search-input"
                    field={@search_form[:q]}
                    type="text"
                    placeholder="Try genesis, chicago, Hungrybox…"
                    autocomplete="off"
                    phx-debounce="300"
                    class="h-12 w-full rounded-none border-2 bg-[var(--surface)] pl-10 pr-3 text-[15px] font-medium placeholder:text-[var(--muted)] focus:border-[var(--accent)] focus:ring-0"
                    style="border-color:var(--border); color:var(--text)"
                  />
                </div>
                <.btn variant="primary" type="submit" class="hidden rounded-none sm:inline-flex" phx-click={JS.dispatch("hero-search-submit", to: "#hero-search-form")}>Search</.btn>
              </div>
            </.form>
            <div class="mt-3 flex flex-wrap items-center gap-2 text-xs" style="color:var(--muted)">
              <span>Or paste a start.gg link</span>
              <.form for={@link_form} id="link-jump-form-compact" phx-submit="link-jump" class="inline-flex gap-1">
                <.input field={@link_form[:link]} type="text" placeholder="start.gg/tournament/…" class="h-7 w-44 rounded-none border bg-[var(--surface)] px-2 text-xs" style="border-color:var(--border)" />
                <.btn variant="ghost" size="sm" type="submit" class="h-7 rounded-none px-2 text-xs">Open</.btn>
              </.form>
            </div>
          </div>
        </div>

        <div class="w-full shrink-0 lg:w-[380px] space-y-3">
          <div class="rounded-none border-2 bg-[var(--surface2)] p-3" style="border-color:var(--border)">
            <div class="flex items-center justify-between text-[10px] font-bold uppercase tracking-[0.18em]" style="color:var(--muted)">
              <span>Live Atlas — 2026</span><span class="rounded bg-[var(--accent)] px-1.5 py-0.5 text-[9px] leading-none" style="color:var(--accent-text)">40 regions</span>
            </div>
            <div class="mt-2 grid grid-cols-4 gap-1.5 text-center">
              <div class="border p-2" style="border-color:var(--border); background:var(--surface)"><div class="text-xs font-black" style="color:var(--text)">CA</div><div class="text-[10px]" style="color:var(--muted)">412</div></div>
              <div class="border p-2" style="border-color:var(--border); background:var(--surface)"><div class="text-xs font-black" style="color:var(--text)">TX</div><div class="text-[10px]" style="color:var(--muted)">298</div></div>
              <div class="border p-2" style="border-color:var(--border); background:var(--surface)"><div class="text-xs font-black" style="color:var(--text)">NY</div><div class="text-[10px]" style="color:var(--muted)">241</div></div>
              <div class="border p-2" style="border-color:var(--border); background:var(--surface)"><div class="text-xs font-black" style="color:var(--text)">FL</div><div class="text-[10px]" style="color:var(--muted)">198</div></div>
            </div>
            <a href="/atlas" class="mt-2 inline-flex items-center gap-1 text-xs font-bold hover:underline" style="color:var(--accent-dark)">Open full Atlas →</a>
          </div>
          <div class="rounded-none border-2 p-3 text-xs leading-relaxed" style="border-color:var(--border); background:var(--accent); color:var(--accent-text)">
            <span class="font-black">No account needed.</span> Search, brackets, and graphs are open. Log in only for bookmarks and leagues.
          </div>
        </div>
      </div>
    </section>

    <!-- Controls: Upcoming/Past/Search tabs as pill toggles in card2 + game filter chips -->
    <section class="rounded-2xl border border-[var(--border)] bg-[var(--surface2)] p-2">
      <div class="flex flex-wrap items-center gap-1">
        <.link
          patch={browse_path(:upcoming, zip: @zip, radius: @radius, game: @game)}
          class={tab_class(@mode == :upcoming) <> " rounded-full"}
        >
          <.icon name="hero-bolt" class="size-4" />
          <span>Upcoming</span>
        </.link>
        <.link
          patch={browse_path(:past, game: @game)}
          class={tab_class(@mode == :past) <> " rounded-full"}
        >
          <.icon name="hero-clock" class="size-4" />
          <span>Past</span>
        </.link>
        <.link
          patch={browse_path(:search, q: @q, game: @game)}
          class={tab_class(@mode == :search) <> " rounded-full"}
        >
          <.icon name="hero-magnifying-glass" class="size-4" />
          <span>Search</span>
        </.link>
        <span class="mx-1 hidden h-5 w-px bg-[var(--border)] sm:block"></span>
        <.link
          navigate={~p"/regions"}
          class="flex items-center gap-1.5 rounded-full border border-[var(--border)] bg-[var(--surface)] px-4 py-1.5 text-sm font-medium text-[var(--muted)] transition-colors hover:border-[var(--border2)] hover:text-[#f5f3ff]"
        >
          <.icon name="hero-globe-americas" class="size-4" />
          <span>Regions</span>
        </.link>
        <.link
          navigate={~p"/atlas"}
          class="flex items-center gap-1.5 rounded-full border border-[var(--border)] bg-[var(--surface)] px-3 py-1.5 text-xs font-bold tracking-wide text-[var(--muted)] transition-colors hover:border-[var(--border2)] hover:text-[#f5f3ff]"
        >
          Atlas
          <span class="rounded-full bg-[#ffcc00] px-1 py-0.5 text-[9px] font-bold leading-none text-[#08070b]">NEW</span>
        </.link>
      </div>

      <div id="game-filter" class="mt-3 flex flex-wrap items-center gap-2">
        <span class="mr-1 text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--muted)]">
          Game
        </span>
        <% chips =
          ([%{slug: KusaData.Games.default().slug, short_name: "Melee"}] ++
             [
               %{slug: "all", short_name: "All"}
               | Enum.reject(@known_games, &(&1.slug == KusaData.Games.default().slug))
             ])
          |> Enum.uniq_by(& &1.slug) %>
        <%= for chip <- chips do %>
          <% slug = if(chip.slug == KusaData.Games.default().slug, do: nil, else: chip.slug) %>
          <.link
            patch={
              game_chip_path(
                %{
                  mode: @mode,
                  zip: @zip,
                  radius: @radius,
                  from: @from,
                  to: @to,
                  q: @q,
                  results_only: @results_only
                },
                slug
              )
            }
            class={[
              "rounded-full px-3 py-1 text-[13px] font-medium transition-colors",
              active_game?(chip.slug, @game) &&
                "bg-[#ffcc00] bg-lime-400 text-[#08070b] hover:bg-[#b8f05a]",
              !active_game?(chip.slug, @game) &&
                "border border-[var(--border)] bg-[var(--surface)] text-[var(--muted)] hover:border-[var(--border2)] hover:text-[#f5f3ff]"
            ]}
          >
            {chip.short_name}
          </.link>
        <% end %>
      </div>
    </section>

    <!-- Mode-specific panels — glass / rounded-xl inputs -->
    <section class="rounded-2xl border border-[var(--border)] bg-[var(--surface)]/80 p-5 backdrop-blur-sm sm:p-6">
      <%= cond do %>
        <% @mode == :upcoming -> %>
          <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-end">
            <div>
              <h2 class="text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--muted)]">
                01 / Find nearby
              </h2>
              <p class="mt-2 max-w-xl text-[15px] leading-relaxed text-[var(--muted)]">
                Tournaments within a radius of any postal code.
              </p>

              <.form
                for={@nearby_form}
                id="nearby-form"
                phx-submit="nearby-search"
                phx-change="radius-change"
                class="mt-4 flex max-w-xl flex-col gap-3 sm:flex-row"
              >
                <.input
                  field={@nearby_form[:zip]}
                  type="text"
                  placeholder="Zip or postal code"
                  inputmode="numeric"
                  autocomplete="postal-code"
                  class="h-11 w-full rounded-xl border border-[var(--border)] bg-[var(--surface2)] px-4 text-sm text-[#f5f3ff] placeholder:text-[var(--muted)] focus:border-[#ffcc00]/50 focus:ring-2 focus:ring-[#ffcc00]/15"
                />
                <.input
                  field={@nearby_form[:radius]}
                  type="select"
                  options={Enum.map(@radii, fn r -> {r, r} end)}
                  class="h-11 w-full rounded-xl border border-[var(--border)] bg-[var(--surface2)] px-3 text-sm text-[#f5f3ff] focus:border-[#ffcc00]/50 sm:w-32"
                />
                <.btn variant="primary" size="lg" type="submit" class="rounded-xl">
                  Search nearby
                </.btn>
              </.form>

              <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
                <span class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--muted)]">
                  Try a city
                </span>
                <%= for {city, zip, radius} <- [
                  {"Minneapolis", "55401", "50mi"},
                  {"Chicago", "60601", "100mi"},
                  {"New York", "10001", "100mi"},
                  {"Los Angeles", "90012", "100mi"}
                ] do %>
                  <.link
                    patch={browse_path(:upcoming, zip: zip, radius: radius, game: @game)}
                    class="inline-flex items-center gap-1.5 text-[15px] text-[#f5f3ff] transition-colors hover:text-[#ffcc00]"
                  >
                    <.icon name="hero-map-pin" class="size-3.5 text-[var(--muted)]" />
                    {city}
                  </.link>
                <% end %>
              </div>
            </div>

            <div class="hidden shrink-0 rounded-2xl border border-[var(--border)] bg-[var(--surface2)] px-5 py-4 md:block">
              <p class="font-mono text-2xl text-[#ffcc00]">24/7</p>
              <p class="mt-1 text-[10px] uppercase tracking-[0.16em] text-[var(--muted)]">
                Bracket watch
              </p>
            </div>
          </div>
        <% @mode == :past -> %>
          <div>
            <h2 class="text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--muted)]">
              02 / Past tournaments
            </h2>
            <p class="mt-2 max-w-xl text-[15px] leading-relaxed text-[var(--muted)]">
              Finished brackets by date range, with a name/city/venue search and a
              results-only switch.
            </p>

            <.form
              for={@past_form}
              id="past-form"
              phx-submit="past-search"
              class="mt-4 flex max-w-3xl flex-col gap-3 md:flex-row md:items-end"
            >
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--muted)]">
                  From
                </label>
                <.input
                  field={@past_form[:from]}
                  type="date"
                  class="h-11 rounded-xl border border-[var(--border)] bg-[var(--surface2)] px-3 text-sm text-[#f5f3ff] focus:border-[#ffcc00]/50 focus:ring-2 focus:ring-[#ffcc00]/15"
                />
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--muted)]">
                  To
                </label>
                <.input
                  field={@past_form[:to]}
                  type="date"
                  class="h-11 rounded-xl border border-[var(--border)] bg-[var(--surface2)] px-3 text-sm text-[#f5f3ff] focus:border-[#ffcc00]/50 focus:ring-2 focus:ring-[#ffcc00]/15"
                />
              </div>
              <div class="flex min-w-0 flex-1 flex-col gap-1.5">
                <label class="text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--muted)]">
                  Name / city / venue
                </label>
                <.input
                  field={@past_form[:q]}
                  type="text"
                  placeholder="genesis, chicago, convention center…"
                  autocomplete="off"
                  class="h-11 w-full rounded-xl border border-[var(--border)] bg-[var(--surface2)] px-4 text-sm text-[#f5f3ff] placeholder:text-[var(--muted)] focus:border-[#ffcc00]/50 focus:ring-2 focus:ring-[#ffcc00]/15"
                />
              </div>
              <div class="flex h-11 items-center">
                <.input
                  field={@past_form[:results_only]}
                  type="checkbox"
                  label="Results only"
                  class="size-4 rounded border-[var(--border)] bg-[var(--surface2)] text-[#ffcc00] accent-[#ffcc00]"
                />
              </div>
              <.btn variant="primary" size="lg" type="submit" class="rounded-xl">
                Browse past
              </.btn>
            </.form>

            <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
              <span class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--muted)]">
                Quick ranges
              </span>
              <%= for {label, from, to} <- quick_ranges() do %>
                <.link
                  patch={browse_path(:past, from: from, to: to, game: @game)}
                  class="inline-flex items-center gap-1.5 text-[15px] text-[#f5f3ff] transition-colors hover:text-[#ffcc00]"
                >
                  <.icon name="hero-calendar-days" class="size-3.5 text-[var(--muted)]" />
                  {label}
                </.link>
              <% end %>
            </div>
          </div>
        <% @mode == :search -> %>
          <div>
            <h2 class="text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--muted)]">
              03 / Search the archive
            </h2>
            <p class="mt-2 max-w-xl text-[15px] leading-relaxed text-[var(--muted)]">
              Hot search across tournament names, cities, and venues. The active
              terms live in the URL, so refresh and back still reproduce them.
            </p>

            <.form
              for={@search_form}
              id="search-form"
              phx-change="search-input"
              class="mt-4 max-w-2xl"
            >
              <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-0 z-10 flex items-center pl-4">
                  <.icon name="hero-magnifying-glass" class="size-5 text-[var(--muted)]" />
                </span>
                <.input
                  field={@search_form[:q]}
                  type="text"
                  placeholder="Search tournaments, cities, venues…"
                  autocomplete="off"
                  phx-debounce="400"
                  class="h-12 w-full rounded-xl border border-[var(--border)] bg-[var(--surface2)] pl-12 pr-4 text-[15px] text-[#f5f3ff] placeholder:text-[var(--muted)] focus:border-[#ffcc00]/50 focus:ring-2 focus:ring-[#ffcc00]/15"
                />
              </div>
            </.form>
          </div>
      <% end %>
    </section>

    <!-- Tournament grid header + bento grid -->
    <section class="rounded-2xl border border-[var(--border)] bg-[var(--surface)]/80 p-5 backdrop-blur-sm sm:p-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-[var(--muted)]">
            {mode_subtitle(%{mode: @mode, zip: @zip, place: @place, from: @from, to: @to, q: @q})}
          </p>
          <h2 class="mt-2 text-2xl font-semibold tracking-tight text-[#f5f3ff]">
            {mode_title(@mode)}
          </h2>
          <p class="mt-1 text-[15px] text-[var(--muted)]">
            {format_count(@total)}
            <%= if @mode == :upcoming do %>
              · {if @zip, do: "within #{@radius} of #{@zip}", else: "worldwide"}
            <% end %>
            · {game_label(@game) || "Melee"}
            <%= if @mode == :past && @results_only do %>
              · results only
            <% end %>
          </p>
        </div>
        <div :if={@mode == :upcoming && @zip} class="flex gap-2">
          <.btn variant="ghost" size="sm" patch={browse_path(:upcoming, [])} class="rounded-xl">
            Browse all upcoming
          </.btn>
        </div>
        <div :if={@mode == :past && (@from || @to || @q || @results_only)} class="flex gap-2">
          <.btn variant="ghost" size="sm" patch={browse_path(:past, [])} class="rounded-xl">
            Clear past filters
          </.btn>
        </div>
      </div>

      <TournamentGrid.tournament_grid
        tournaments={@streams.tournaments}
        total={@total}
        loading={@loading}
        error={@error}
        empty_title={
          if(@mode == :search && is_nil(@q), do: "Type to search", else: "No tournaments found")
        }
        empty_body={empty_hint(%{mode: @mode, error: @error})}
        reset_link={browse_path(:upcoming, [])}
        reset_label="Browse all upcoming"
        next_page={@next_page}
      />
    </section>
  </div>
</Layouts.app>
