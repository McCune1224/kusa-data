<Layouts.app flash={@flash} nav={@nav}>
  <div class="desk-grid animate-fade-up">
    <div class="mb-5 flex items-center justify-between border-y border-stone-800 py-3 text-[10px] font-semibold uppercase tracking-[0.24em] text-stone-500">
      <span><span class="mr-2 inline-block size-2 bg-lime-400"></span>Live bracket index</span>
      <span class="hidden sm:inline">North America / 2026</span>
      <span class="text-orange-300">01 — Discover</span>
    </div>

    <section class="grid border-b border-stone-800 lg:grid-cols-[1.25fr_0.75fr]">
      <div class="border-b border-stone-800 pb-10 pt-5 lg:border-b-0 lg:border-r lg:pb-16 lg:pr-14">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-lime-300">
          The competitive Melee desk
        </p>
        <h1 class="mt-5 max-w-4xl text-6xl font-black uppercase leading-[0.88] tracking-[-0.07em] text-stone-50 sm:text-8xl">
          Find your next<br /><span class="text-lime-400">bracket.</span>
        </h1>
        <p class="mt-8 max-w-lg border-l-2 border-orange-300 pl-4 text-[16px] leading-relaxed text-stone-300">
          A sharper way to follow tournaments, discover players, and get from a postal code to a bracket in seconds.
        </p>
      </div>

      <div class="flex flex-col justify-between bg-stone-900/40 px-0 py-6 lg:pl-10">
        <div class="flex items-start justify-between border-b border-stone-800 pb-5">
          <div>
            <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-stone-500">
              Index note
            </p>
            <p class="mt-2 max-w-xs text-2xl font-semibold leading-tight text-stone-100">
              Know where the scene is moving.
            </p>
          </div>
          <span class="font-mono text-xs text-orange-300">K/D 01</span>
        </div>
        <div class="mt-8 grid grid-cols-2 gap-px border border-stone-800 bg-stone-800">
          <div class="bg-stone-950 px-4 py-4">
            <p class="font-mono text-2xl text-lime-300">24/7</p>
            <p class="mt-1 text-[10px] uppercase tracking-[0.16em] text-stone-500">
              Bracket watch
            </p>
          </div>
          <div class="bg-stone-950 px-4 py-4">
            <p class="font-mono text-2xl text-orange-300">LIVE</p>
            <p class="mt-1 text-[10px] uppercase tracking-[0.16em] text-stone-500">
              start.gg feed
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-stone-800 py-8">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-orange-300">
            Search the index
          </p>
          <h2 class="mt-2 text-2xl font-bold uppercase tracking-[-0.03em] text-stone-100">
            Start anywhere.
          </h2>
        </div>
        <span class="hidden font-mono text-xs text-stone-600 sm:inline">INPUT / OUTPUT</span>
      </div>

      <div class="grid gap-8 md:grid-cols-2 md:gap-0 md:divide-x md:divide-stone-800">
        <div>
          <h2 class="text-[11px] font-medium uppercase tracking-[0.2em] text-stone-400">
            01 / Find nearby
          </h2>
          <p class="mt-2 text-[15px] leading-relaxed text-stone-400">
            Tournaments within a radius of any postal code.
          </p>

          <.form
            for={@form}
            id="nearby-form"
            phx-submit="nearby-search"
            phx-change="radius-change"
            class="mt-5 space-y-3"
          >
            <.input
              field={@form[:zip]}
              type="text"
              placeholder="Zip or postal code"
              inputmode="numeric"
              autocomplete="postal-code"
              class="h-11 w-full rounded-none border border-stone-700/70 bg-stone-950 px-4 text-sm text-stone-200 placeholder-stone-600 focus:border-lime-400/50 focus:ring-2 focus:ring-lime-400/15"
            />
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
              <.input
                field={@form[:radius]}
                type="select"
                options={Enum.map(@radii, fn r -> {r, r} end)}
                class="h-11 w-full rounded-none border border-stone-700/70 bg-stone-950 px-3 text-sm text-stone-200 focus:border-lime-400/50 sm:w-32"
              />
              <.btn
                variant="primary"
                size="lg"
                type="submit"
                class="rounded-none flex-1 sm:flex-none sm:px-6"
              >
                Search nearby
              </.btn>
            </div>
          </.form>
        </div>

        <div class="md:pl-8 lg:pl-10">
          <h2 class="text-[11px] font-medium uppercase tracking-[0.2em] text-stone-400">
            02 / Jump to a bracket
          </h2>
          <p class="mt-2 text-[15px] leading-relaxed text-stone-400">
            Paste a start.gg link or slug and open it directly.
          </p>

          <.form for={@link_form} id="link-jump-form" phx-submit="link-jump" class="mt-5">
            <div class="flex flex-col gap-3 sm:flex-row">
              <.input
                field={@link_form[:link]}
                type="text"
                placeholder="start.gg/tournament/…"
                autocomplete="off"
                class="h-11 w-full rounded-none border border-stone-700/70 bg-stone-950 px-4 text-sm text-stone-200 placeholder-stone-600 focus:border-lime-400/50 focus:ring-2 focus:ring-lime-400/15"
              />
              <.btn
                variant="secondary"
                size="lg"
                type="submit"
                icon_right="hero-arrow-right"
                class="rounded-none flex-1 sm:flex-none sm:px-6"
              >
                Open
              </.btn>
            </div>
          </.form>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-stone-800/70 pt-5">
        <span class="text-xs font-medium uppercase tracking-[0.18em] text-stone-500">
          Try a city
        </span>
        <%= for {city, zip, radius} <- [
          {"Minneapolis", "55401", "50mi"},
          {"Chicago", "60601", "100mi"},
          {"New York", "10001", "100mi"},
          {"Los Angeles", "90012", "100mi"}
        ] do %>
          <.link
            patch={~p"/?zip=#{zip}&radius=#{radius}"}
            class="inline-flex items-center gap-1.5 text-[15px] text-stone-300 transition-colors hover:text-lime-300"
          >
            <.icon name="hero-map-pin" class="size-3.5 text-stone-600" />
            {city}
          </.link>
        <% end %>
      </div>
    </section>

    <section class="mt-12">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-stone-400">
            {if @mode == :nearby, do: "near #{place_city(@place)}", else: "tournaments"}
          </p>
          <h2 class="mt-2 text-2xl font-semibold tracking-tight text-stone-100">
            <%= if @mode == :nearby do %>
              Melee near <span class="text-lime-300">{place_city(@place)}</span>
            <% else %>
              Upcoming tournaments
            <% end %>
          </h2>
          <p class="mt-1 text-[15px] text-stone-400">
            {format_count(@total)} · {radius_label(@mode, @radius)}
          </p>
        </div>
        <div :if={@mode == :nearby}>
          <.btn variant="ghost" size="sm" patch={~p"/"} class="rounded-none">
            Browse all upcoming
          </.btn>
        </div>
      </div>

      <%= cond do %>
        <% @loading && @total == 0 -> %>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <.skeleton :for={_ <- 1..6} class="h-40 rounded-none" />
          </div>
        <% @total == 0 -> %>
          <div class="mt-6">
            <.empty_state icon="hero-inbox" title="No tournaments found">
              <:body>No tournaments found{no_results_hint(@error)}</:body>
              <:action>
                <.btn variant="secondary" patch={~p"/"} class="rounded-none">
                  Browse all upcoming
                </.btn>
              </:action>
            </.empty_state>
          </div>
        <% true -> %>
          <div
            id="tournaments"
            phx-update="stream"
            class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
          >
            <div
              id="tournaments-empty"
              class="hidden border border-dashed border-stone-800 px-6 py-12 text-center text-[15px] text-stone-400 only:block"
            >
              No tournaments found{no_results_hint(@error)}
            </div>

            <div :for={{id, tournament} <- @streams.tournaments} id={id} class="h-full">
              <.link
                navigate={~p"/tournament/#{bare_slug(tournament["slug"])}"}
                class="group block h-full"
              >
                <div class="rule-hover flex h-full flex-col border border-stone-800 bg-stone-900/40 p-5 transition-colors group-hover:border-stone-600 group-hover:bg-stone-900/70">
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="line-clamp-2 text-lg font-medium leading-snug text-stone-200 transition-colors group-hover:text-stone-50">
                      {tournament["name"]}
                    </h3>
                    <span class="shrink-0 border border-stone-700/70 px-2.5 py-1 font-mono text-xs text-stone-400">
                      {date_badge(tournament)}
                    </span>
                  </div>

                  <div class="mt-5 flex-1 space-y-2 text-[15px] text-stone-400">
                    <span class="flex items-center gap-2">
                      <.icon name="hero-map-pin" class="size-3.5 text-stone-600" />
                      {location_label(tournament)}
                    </span>
                    <span class="flex items-center gap-2">
                      <.icon name="hero-trophy" class="size-3.5 text-stone-600" />
                      {event_count(tournament)} event{plural(event_count(tournament))}
                    </span>
                  </div>

                  <div class="mt-5 flex items-center justify-between border-t border-stone-800/70 pt-4">
                    <span class="inline-flex items-center gap-1.5 text-xs text-stone-500">
                      <span
                        class={[
                          "size-1.5 rounded-full",
                          if(tournament["isRegistrationOpen"],
                            do: "bg-emerald-400",
                            else: "bg-stone-700"
                          )
                        ]}
                        aria-hidden="true"
                      ></span>
                      {if tournament["isRegistrationOpen"], do: "reg open", else: "no open reg"}
                    </span>
                    <span class="inline-flex items-center gap-1 text-xs font-medium text-lime-400/0 transition-colors group-hover:text-lime-300">
                      View bracket <.icon name="hero-arrow-right" class="size-3.5" />
                    </span>
                  </div>
                </div>
              </.link>
            </div>
          </div>
      <% end %>

      <div class="mt-10 flex justify-center">
        <%= if @next_page do %>
          <.btn
            variant="ghost"
            icon="hero-chevron-down"
            phx-click="load-more"
            phx-disable-with="Loading…"
            class="rounded-none"
          >
            Load more
          </.btn>
        <% end %>
      </div>
    </section>
  </div>
</Layouts.app>
