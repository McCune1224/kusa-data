<Layouts.app flash={@flash} nav={@nav} current_user={@current_user}>
  <div class="min-h-[80vh]">
    <div class="border-b-2 border-[#ffcc00] bg-[#08070b] px-4 py-2 text-[11px] font-black uppercase tracking-[0.16em] text-[#ffcc00] sm:px-6">
      <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 animate-pulse bg-[#ffcc00]"></span>
      Live — 2026 season · 40 regions · Atlas is live</span>
      <span class="float-right hidden sm:inline">Melee</span>
    </div>

    <section class="bg-[#08070b] px-4 py-10 sm:px-6 sm:py-14">
      <div class="mx-auto max-w-3xl">
        <p class="font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-[#ffcc00]">
          KusaData — Find tournaments
        </p>
        <h1 class="mt-3 font-black leading-[0.9] tracking-[-0.06em] text-white text-[48px] sm:text-[64px]">
          Search<br /><span class="underline decoration-[#ffcc00] decoration-4 underline-offset-8">everything.</span>
        </h1>
        <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-[#9a95b0]">
          Every tournament, every city, every player. Type and the bracket finds you.
        </p>

        <div class="mt-8 border-2 border-[#ffcc00] bg-white p-3">
          <.form
            for={@search_form}
            id="hero-search-form"
            phx-change="search-input"
            class="flex gap-2"
          >
            <div class="relative flex-1">
              <.input
                field={@search_form[:q]}
                type="text"
                placeholder="Search genesis, chicago, Hungrybox…"
                autocomplete="off"
                phx-debounce="300"
                class="h-12 w-full rounded-none border-2 border-black bg-white px-4 text-[16px] font-medium text-black placeholder:text-zinc-500 focus:border-black focus:ring-0"
              />
            </div>
            <.btn
              variant="primary"
              type="submit"
              class="hidden rounded-none bg-[#ffcc00] text-black hover:bg-[#ffcc00] sm:inline-flex"
            >
              Search
            </.btn>
          </.form>
          <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-zinc-600">
            <span>Try:</span>
            <button
              phx-click="search-input"
              phx-value-q="genesis"
              class="underline decoration-zinc-300 underline-offset-4 hover:decoration-black"
            >genesis</button>
            <span>·</span>
            <button
              phx-click="search-input"
              phx-value-q="chicago"
              class="underline decoration-zinc-300 underline-offset-4 hover:decoration-black"
            >chicago</button>
            <span>·</span>
            <button
              phx-click="search-input"
              phx-value-q="Mang0"
              class="underline decoration-zinc-300 underline-offset-4 hover:decoration-black"
            >Mang0</button>
            <span class="ml-auto hidden items-center gap-1 font-mono text-[11px] sm:inline-flex">Press
            <span class="border border-black px-1">/</span>
            to focus</span>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-3 text-xs">
          <.link
            navigate={~p"/atlas"}
            class="inline-flex items-center gap-1.5 border-2 border-[#ffcc00] bg-[#ffcc00] px-3 py-1.5 font-bold uppercase tracking-wide text-black"
          >Open Atlas →</.link>
          <span class="text-[#9a95b0]">or browse below</span>
        </div>
      </div>
    </section>

    <section class="border-t-2 border-black bg-white px-4 py-6 sm:px-6">
      <div class="mx-auto max-w-3xl">
        <div class="flex flex-wrap items-center gap-2 border-b-2 border-black pb-3">
          <.link
            patch={browse_path(:upcoming, zip: @zip, radius: @radius, game: @game)}
            class={[
              "px-3 py-1 text-sm font-black uppercase tracking-wide",
              @mode == :upcoming && "bg-black text-white",
              @mode != :upcoming && "bg-white text-black border border-black hover:bg-zinc-50"
            ]}
          >Upcoming</.link>
          <.link
            patch={browse_path(:past, game: @game)}
            class={[
              "px-3 py-1 text-sm font-black uppercase tracking-wide",
              @mode == :past && "bg-black text-white",
              @mode != :past && "bg-white text-black border border-black hover:bg-zinc-50"
            ]}
          >Past</.link>
          <.link
            patch={browse_path(:search, q: @q, game: @game)}
            class={[
              "px-3 py-1 text-sm font-black uppercase tracking-wide",
              @mode == :search && "bg-black text-white",
              @mode != :search && "bg-white text-black border border-black hover:bg-zinc-50"
            ]}
          >Search</.link>
          <span class="ml-auto hidden items-center gap-1.5 text-xs font-bold uppercase tracking-wide text-zinc-500 sm:inline-flex"><.icon
            name="hero-globe-americas"
            class="size-4"
          /> <a href="/regions" class="underline">Regions</a>
          · <a href="/atlas" class="underline">Atlas</a></span>
        </div>

        <div class="mt-3 flex flex-wrap items-center gap-2">
          <span class="text-[11px] font-black uppercase tracking-widest text-zinc-500">Game</span>
          <%= for chip <- [%{slug: KusaData.Games.default().slug, short_name: "Melee"}, %{slug: "all", short_name: "All"} | Enum.reject(@known_games, &(&1.slug == KusaData.Games.default().slug))] |> Enum.uniq_by(& &1.slug) do %>
            <% slug = if(chip.slug == KusaData.Games.default().slug, do: nil, else: chip.slug) %>
            <.link
              patch={
                game_chip_path(
                  %{
                    mode: @mode,
                    zip: @zip,
                    radius: @radius,
                    from: @from,
                    to: @to,
                    q: @q,
                    results_only: @results_only
                  },
                  slug
                )
              }
              class={[
                "px-2.5 py-1 text-xs font-bold uppercase tracking-wide border",
                active_game?(chip.slug, @game) && "bg-[#ffcc00] border-black text-black",
                !active_game?(chip.slug, @game) &&
                  "bg-white border-black text-black hover:bg-zinc-50"
              ]}
            >
              {chip.short_name}
            </.link>
          <% end %>
        </div>

        <div class="mt-6 border-2 border-black bg-white p-4">
          <%= cond do %>
            <% @mode == :upcoming -> %>
              <div>
                <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-zinc-500">
                  Find nearby
                </h2>
                <.form
                  for={@nearby_form}
                  id="nearby-form"
                  phx-submit="nearby-search"
                  phx-change="radius-change"
                  class="mt-3 flex flex-col gap-2 sm:flex-row"
                >
                  <.input
                    field={@nearby_form[:zip]}
                    type="text"
                    placeholder="Zip code"
                    class="h-10 flex-1 rounded-none border-2 border-black bg-white px-3 text-sm"
                  />
                  <.input
                    field={@nearby_form[:radius]}
                    type="select"
                    options={Enum.map(@radii, fn r -> {r, r} end)}
                    class="h-10 rounded-none border-2 border-black bg-white px-2 text-sm sm:w-28"
                  />
                  <.btn
                    variant="primary"
                    size="lg"
                    type="submit"
                    class="rounded-none bg-black text-white hover:bg-zinc-900"
                  >
                    Search nearby
                  </.btn>
                </.form>
              </div>
            <% @mode == :past -> %>
              <div>
                <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-zinc-500">
                  Past tournaments — 2026
                </h2>
                <.form
                  for={@past_form}
                  id="past-form"
                  phx-submit="past-search"
                  class="mt-3 grid gap-2 sm:grid-cols-[140px_140px_1fr_auto]"
                >
                  <.input
                    field={@past_form[:from]}
                    type="date"
                    class="h-10 rounded-none border-2 border-black bg-white px-2 text-sm"
                  />
                  <.input
                    field={@past_form[:to]}
                    type="date"
                    class="h-10 rounded-none border-2 border-black bg-white px-2 text-sm"
                  />
                  <.input
                    field={@past_form[:q]}
                    type="text"
                    placeholder="Name / city / venue"
                    class="h-10 rounded-none border-2 border-black bg-white px-3 text-sm"
                  />
                  <.btn
                    variant="primary"
                    type="submit"
                    class="h-10 rounded-none bg-black text-white"
                  >
                    Browse
                  </.btn>
                </.form>
              </div>
            <% @mode == :search -> %>
              <div class="font-mono text-xs font-bold uppercase tracking-widest text-zinc-500">
                Search is above — type in the big field
              </div>
          <% end %>
        </div>
      </div>
    </section>

    <section class="bg-[#f5f3ef] px-4 py-6 sm:px-6">
      <div class="mx-auto max-w-3xl">
        <div class="flex items-baseline justify-between gap-4 border-b-2 border-black pb-2">
          <h2 class="font-black uppercase tracking-tight text-black text-xl">
            {mode_title(@mode)}
          </h2>
          <span class="font-mono text-xs text-zinc-600">{format_count(@total)} · {game_label(
            @game
          ) || "Melee"}</span>
        </div>
        <div class="mt-4">
          <TournamentGrid.tournament_grid
            tournaments={@streams.tournaments}
            total={@total}
            loading={@loading}
            error={@error}
            empty_title={
              if(@mode == :search && is_nil(@q),
                do: "Type to search",
                else: "No tournaments found"
              )
            }
            empty_body={empty_hint(%{mode: @mode, error: @error})}
            reset_link={browse_path(:upcoming, [])}
            reset_label="Browse all upcoming"
            next_page={@next_page}
          />
        </div>
      </div>
    </section>
  </div>
</Layouts.app>
