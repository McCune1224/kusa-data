# start.gg API bearer token (required for live API calls, crawl, search fallback)
# Get one at https://start.gg/admin/developer
ACCESS_TOKEN=your_startgg_token_here

# Redis connection string for the cache layer (optional — app degrades to
# uncached start.gg calls when missing/unreachable)
# Example: redis://localhost:6379
REDIS_URL=redis://localhost:6379
