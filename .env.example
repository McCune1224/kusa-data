# start.gg GraphQL API token — get one from https://developer.start.gg
ACCESS_TOKEN=

# Optional Redis cache connection. Leave empty to run uncached.
REDIS_URL=

# Required in production (config/runtime.exs raises if missing).
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Public hostname the app is served at (your Railway domain, no scheme).
# Example: kusa-data.up.railway.app
PHX_HOST=
